{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/main",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/domain/**/*.ts",
    "src/persistence/**/*.ts",
    "src/services/**/*.ts"
  ]
}
