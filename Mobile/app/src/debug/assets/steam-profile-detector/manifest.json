{
  "manifest_version": 2,
  "name": "Steam Account Manager Profile Detector",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "steam-profile-detector@steam-account-manager.invalid" }
  },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/*", "https://www.steamcommunity.com/*"],
      "js": ["fixture.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
