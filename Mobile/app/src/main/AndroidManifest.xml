<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SteamAccountManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SteamAccountManager"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!--
          MainActivity hosts all Compose UI (home, add account, website picker,
          settings, app lock). Browser engine work remains in the dedicated process.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SteamAccountManager"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          BrowserActivity runs one isolated Gecko session in :browser. Switching sessions restarts this
          worker so only one engine-owned profile is resident at a time.
        -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:process=":browser"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SteamAccountManager"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!--
          Runs in :browser and requests graceful engine shutdown before a different
          isolated session can be authorized.
        -->
        <receiver
            android:name=".browser.BrowserShutdownReceiver"
            android:exported="false"
            android:process=":browser">
            <intent-filter>
                <action android:name="com.steamaccountmanager.app.action.SHUTDOWN_BROWSER_PROCESS" />
            </intent-filter>
        </receiver>

        <receiver android:name=".browser.BrowserNotificationDismissReceiver"
            android:exported="false" android:process=":browser" />

        <!-- Runs in the default process; receives the avatar-detection broadcast from :browser. -->
        <receiver
            android:name=".browser.SteamProfileResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.steamaccountmanager.app.action.STEAM_PROFILE_DETECTED" />
            </intent-filter>
        </receiver>

        <!-- App lock is shown as its own activity so it can also gate task-switcher re-entry. -->
        <activity
            android:name=".ui.lock.AppLockActivity"
            android:exported="false"
            android:theme="@style/Theme.SteamAccountManager"
            android:excludeFromRecents="false" />

    </application>
</manifest>
